<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон окна активности — сама игровая картинка, растянутая на окно.

    Полосы по краям экрана находятся ВНЕ WebView: это доказано тем, что они
    перестали быть белыми ровно после того, как окну задали цвет. CSS туда не
    достаёт по определению, поэтому закрывать их надо здесь.

    gravity="fill" растягивает по обеим осям. Для этого фона это допустимо:
    у game-calm края почти ровные, светло-бирюзовые, и растяжение узкой полосы
    незаметно — в отличие от плоской заливки, которая читалась как пустое место.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/window_bg"
    android:gravity="fill" />
